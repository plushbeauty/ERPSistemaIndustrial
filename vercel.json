    },
    {
      "source": "/tabelas-preco",
      "destination": "/index.html"
    },
    {
      "source": "/almoxarifado",
      "destination": "/index.html"
    },
    {
      "source": "/pedidos-vendas",
      "destination": "/index.html"
    },
    {
      "source": "/central-qualidade",
      "destination": "/index.html"
    },
    {
      "source": "/rh",
      "destination": "/index.html"
    },
    {
      "source": "/fiscal/nova",
      "destination": "/index.html"
    }
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
