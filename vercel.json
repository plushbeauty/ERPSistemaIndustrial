      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/contato",
      "destination": "/index.html"
    },
    {
      "source": "/cadastro-empresa",
      "destination": "/index.html"
    },
    {
      "source": "/configuracao-adm-master",
      "destination": "/index.html"
    },
    {
      "source": "/cadastro-master",
      "destination": "/index.html"
    },
    {
      "source": "/ativar-acesso",
      "destination": "/index.html"
    },
    {
      "source": "/erp-industrial",
      "destination": "/index.html"
    },
    {
      "source": "/modulos/pcp",
      "destination": "/index.html"
    },
    {
      "source": "/modulos/estoque",
      "destination": "/index.html"
    },
    {
      "source": "/modulos/recebimento",
      "destination": "/index.html"
    },
    {
      "source": "/modulos/qualidade",
      "destination": "/index.html"
    },
    {
      "source": "/modulos/manutencao",
      "destination": "/index.html"
    },
    {
      "source": "/modulos/fiscal",
      "destination": "/index.html"
    },
    {
      "source": "/modulos/indicadores",
      "destination": "/index.html"
    },
    {
      "source": "/recebimento-materiais",
      "destination": "/index.html"
    },
    {
      "source": "/pcp",
      "destination": "/index.html"
    },
    {
      "source": "/qualidade",
      "destination": "/index.html"
    },
    {
      "source": "/qualidade/documentos",
      "destination": "/index.html"
    },
    {
      "source": "/operacao-industrial",
      "destination": "/index.html"
    },
    {
      "source": "/produtos-vendas",
      "destination": "/index.html"
    },
    {
